{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local Cognitive AI System Config",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "mcp": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "server": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "transport": {
              "type": "string",
              "enum": ["stdio"],
              "default": "stdio"
            },
            "defaultSessionId": {
              "type": "string",
              "minLength": 1,
              "default": "mcp-default"
            }
          }
        }
      }
    }
  }
}
