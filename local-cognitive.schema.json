{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local Cognitive AI System Config",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "mcp": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "server": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "transport": {
              "type": "string",
              "enum": [
                "stdio"
              ],
              "default": "stdio"
            },
            "defaultSessionId": {
              "type": "string",
              "minLength": 1,
              "default": "mcp-default"
            }
          }
        }
      }
    },
    "localModels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modelsDir": {
          "type": "string",
          "minLength": 1
        },
        "contextSize": {
          "type": "integer",
          "minimum": 512,
          "maximum": 131072,
          "default": 4096
        },
        "gpuLayers": {
          "type": "integer",
          "minimum": 0
        },
        "memoryLimitPercent": {
          "type": "integer",
          "minimum": 10,
          "maximum": 90,
          "default": 75
        },
        "loadTimeoutMs": {
          "type": "integer",
          "minimum": 10000,
          "default": 300000
        },
        "generationTimeoutMs": {
          "type": "integer",
          "minimum": 10000,
          "default": 600000
        }
      }
    }
  }
}
