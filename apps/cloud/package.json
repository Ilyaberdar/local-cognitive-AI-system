{
  "name": "@local-cognitive/cloud",
  "version": "0.1.0",
  "private": true,
  "description": "Local Cognitive Cloud API and relay",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node dist/src/index.js",
    "migrate": "node --env-file-if-exists=.env dist/src/db/migrateCli.js",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\""
  },
  "dependencies": {
    "express": "^4.21.2",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "ws": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
