{
  "name": "local-cognitive-ai-system",
  "version": "0.1.0",
  "private": true,
  "description": "Local Cognitive AI System headless engine",
  "author": "Local Cognitive AI System",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "npm run build:ui && concurrently -k -n server,workflow \"npm:dev:server\" \"npm:dev:ui\"",
    "dev:server": "tsx watch src/index.ts",
    "dev:ui": "vite build --watch",
    "build": "npm run build:server && npm run build:ui",
    "build:server": "tsc -p tsconfig.json",
    "build:ui": "vite build",
    "start": "node dist/src/index.js",
    "mcp:stdio": "node dist/src/mcp.js",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "electron": "npm run build && electron .",
    "dist:mac": "npm run prepare:llama -- --platform darwin --arch arm64 && npm run prepare:llama -- --platform darwin --arch x64 && npm run build && electron-builder --mac dmg --arm64 --x64",
    "dist:mac:arm64": "npm run prepare:llama -- --platform darwin --arch arm64 && npm run build && electron-builder --mac dmg --arm64",
    "dist:mac:x64": "npm run prepare:llama -- --platform darwin --arch x64 && npm run build && electron-builder --mac dmg --x64",
    "dist:win": "npm run prepare:llama -- --platform win32 --arch x64 && npm run build && electron-builder --win nsis --x64",
    "prepare:llama": "node scripts/prepare-llama-runtime.mjs",
    "verify:llama": "node scripts/verify-packaged-runtime.mjs",
    "test:llama": "npm run build && node --test dist/test/llamaCpp.integration.test.js"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xyflow/react": "^12.11.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.localcognitiveai.system",
    "productName": "Local Cognitive AI System",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/src/**/*",
      "dist/plugins/**/*",
      "plugins/**/plugin.json",
      "public/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "resources/llama/darwin-${arch}",
          "to": "llama/darwin-${arch}",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "resources/llama/win32-${arch}",
          "to": "llama/win32-${arch}",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "resources/llama",
        "to": "llama",
        "filter": [
          "runtime-manifest.json",
          "THIRD_PARTY_NOTICES.txt"
        ]
      },
      {
        "from": "resources/models",
        "to": "models",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "optionalDependencies": {
    "electron-liquid-glass": "1.1.1"
  }
}
