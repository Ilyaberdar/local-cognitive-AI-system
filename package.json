{
  "name": "local-cognitive-ai-system",
  "version": "0.1.0",
  "private": true,
  "description": "Local Cognitive AI System headless engine",
  "author": "Local Cognitive AI System",
  "main": "electron/main.cjs",
  "bin": {
    "local-cognitive-server": "dist/src/server/cli.js"
  },
  "workspaces": [
    "apps/cloud"
  ],
  "scripts": {
    "dev": "npm run build:ui && concurrently -k -n server,workflow \"npm:dev:server\" \"npm:dev:ui\"",
    "dev:server": "tsx watch src/index.ts",
    "dev:ui": "concurrently -k \"node scripts/build-markdown.mjs --watch\" \"vite build --watch\"",
    "build": "npm run build:server && npm run build:ui",
    "build:server": "tsc -p tsconfig.json",
    "build:ui": "node scripts/build-markdown.mjs && vite build",
    "start": "node dist/src/index.js",
    "mcp:stdio": "node dist/src/mcp.js",
    "server": "node dist/src/server/cli.js",
    "test:mcp-model": "npm run build:server && node scripts/test-mcp-local-model.cjs",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "electron": "npm run build && electron .",
    "dist:mac": "npm run prepare:llama -- --platform darwin --arch arm64 && npm run prepare:llama -- --platform darwin --arch x64 && npm run prepare:speech -- --arch arm64 && npm run prepare:speech -- --arch x64 && npm run build && electron-builder --mac dmg --arm64 --x64",
    "dist:mac:arm64": "npm run prepare:llama -- --platform darwin --arch arm64 && npm run prepare:speech -- --arch arm64 && npm run build && electron-builder --mac dmg --arm64",
    "dist:mac:x64": "npm run prepare:llama -- --platform darwin --arch x64 && npm run prepare:speech -- --arch x64 && npm run build && electron-builder --mac dmg --x64",
    "dist:win": "npm run prepare:llama -- --platform win32 --arch x64 && npm run prepare:speech -- --platform win32 --arch x64 && npm run build && electron-builder --win nsis --x64",
    "prepare:llama": "node scripts/prepare-llama-runtime.mjs",
    "prepare:llama:server": "node scripts/prepare-llama-runtime.mjs --platform linux --arch x64 && node scripts/prepare-llama-runtime.mjs --variant linux-x64-cuda12",
    "verify:llama": "node scripts/verify-packaged-runtime.mjs",
    "verify:package-secrets": "node scripts/verify-package-secrets.mjs",
    "cloud:build": "npm run build -w @local-cognitive/cloud",
    "cloud:test": "npm test -w @local-cognitive/cloud",
    "cloud:dev": "npm run dev -w @local-cognitive/cloud",
    "cloud:migrate": "npm run migrate -w @local-cognitive/cloud",
    "cloud:db:up": "docker compose -f deploy/cloud/compose.dev.yml up -d --wait",
    "cloud:db:down": "docker compose -f deploy/cloud/compose.dev.yml down",
    "test:llama": "npm run build && node --test dist/test/llamaCpp.integration.test.js",
    "prepare:speech": "node scripts/prepare-speech-runtime.mjs",
    "verify:speech": "node scripts/verify-speech-runtime.mjs"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@sentry/electron": "^8.1.0",
    "@xyflow/react": "^12.11.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cross-spawn": "^7.0.6",
    "dompurify": "3.4.16",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "highlight.js": "11.12.0",
    "mammoth": "1.12.3",
    "markdown-it": "14.3.2",
    "parse5": "7.3.0",
    "pdfjs-dist": "4.8.69",
    "quickjs-emscripten": "0.32.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "smol-toml": "^1.9.1",
    "ws": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.localcognitiveai.system",
    "protocols": [
      {
        "name": "Local Cognitive",
        "schemes": [
          "localcognitive"
        ]
      }
    ],
    "productName": "Local Cognitive AI System",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/*.cjs",
      "dist/src/**/*",
      "public/**/*",
      "package.json",
      "!**/.env",
      "!**/.env.*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "resources/llama/darwin-${arch}",
          "to": "llama/darwin-${arch}",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "resources/speech/darwin-${arch}",
          "to": "speech/darwin-${arch}",
          "filter": [
            "**/*"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Dictate messages using local speech recognition. Audio stays on your computer."
      }
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "resources/llama/win32-${arch}",
          "to": "llama/win32-${arch}",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "resources/speech/win32-${arch}",
          "to": "speech/win32-${arch}",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "resources/llama",
        "to": "llama",
        "filter": [
          "runtime-manifest.json",
          "THIRD_PARTY_NOTICES.txt"
        ]
      },
      {
        "from": "resources/models",
        "to": "models",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "optionalDependencies": {
    "electron-liquid-glass": "1.1.1"
  }
}
