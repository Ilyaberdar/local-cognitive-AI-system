#!/usr/bin/env bash
# local-cognitive-server: the server's commands, shipped with each release. install.sh puts a small
# root-owned /usr/local/bin/local-cognitive-server that sets this host's LC_* settings and runs the
# current release's copy of this script; settings are never read from a file the server's user can
# change, since admins run it with sudo.
#
#   sudo local-cognitive-server               the console: status, a live view and these commands
#   sudo local-cognitive-server pair          connect a computer (Local Cognitive → Remote → Connect)
#   sudo local-cognitive-server status        is it running, can computers reach it
#   sudo local-cognitive-server devices       computers that can connect; revoke-device <id>
#   sudo local-cognitive-server cloud-models  Synthesis projects that may use cloud models; allow|deny <project>
#   sudo local-cognitive-server deps <project> install a project's npm dependencies once (npm ci), for agents' npm test
#   sudo local-cognitive-server api-token     the key of the loopback HTTP API (Authorization: Bearer <key>)
#   sudo local-cognitive-server update        install the newest release (backed up, rolled back if it fails)
#   sudo local-cognitive-server logs | restart | stop | start
#   sudo local-cognitive-server cuda          install the CUDA runtime (NVIDIA GPU, driver 570+)
#   sudo local-cognitive-server sandbox       set up bubblewrap for Synthesis contract tests (installers from 0.1.3 do)
#   sudo local-cognitive-server uninstall     remove the server (keeps its data)
set -euo pipefail

PREFIX="${LC_PREFIX:-/opt/local-cognitive}"
DATA_DIR="${LC_DATA_DIR:-/srv/local-cognitive}"
SERVICE_USER="${LC_SERVICE_USER:-local-cognitive}"
UNIT="${LC_UNIT:-local-cognitive}"
VAULT_KEY_FILE="${LC_VAULT_KEY_FILE:-/etc/local-cognitive/vault.key}"

NODE="$PREFIX/current/node/bin/node"
CLI="$PREFIX/current/dist/src/server/cli.js"
# In a terminal, no command opens the console; elsewhere it prints the help.
if [ $# -eq 0 ] && [ -t 0 ] && [ -t 1 ]; then set -- console; fi
command="${1:-help}"

# Library links of runtimes prepared on this host (the CUDA build): updates up to 0.1.4 copied them
# as absolute paths into the release they came from, so pruning that release left llama-server
# unable to load. A link that names a file by a path, or points nowhere, is pointed back at the
# regular file of that name beside it; nothing outside the runtime folder is followed or changed.
repair_runtimes() {
  local dir link target name
  for dir in "$PREFIX"/current/resources/llama/*/; do
    [ -d "$dir" ] || continue
    for link in "$dir"*; do
      [ -L "$link" ] || continue
      target=$(readlink "$link")
      case "$target" in */*) ;; *) [ -e "$link" ] && continue ;; esac
      name=${target##*/}
      if [ "$name" != "${link##*/}" ] && [ -f "$dir$name" ] && [ ! -L "$dir$name" ]; then
        ln -s "$name" "$link.relink.$$" && mv -f "$link.relink.$$" "$link" && echo "Repaired the library link ${link#"$dir"} ($target)"
      fi
    done
  done
}
need_root() {
  if [ "$(id -u)" -ne 0 ]; then echo "Run: sudo local-cognitive-server $*" >&2; exit 78; fi
}
has_option() {
  local name="$1"; shift
  local argument
  for argument in "$@"; do case "$argument" in "$name" | "$name="*) return 0 ;; esac; done
  return 1
}

# The same as install.sh's: a server installed before 0.1.3 sets bubblewrap up with `sandbox`.
install_package() { # apt-name dnf-name
  if command -v apt-get >/dev/null 2>&1; then
    DEBIAN_FRONTEND=noninteractive apt-get install -y -q "$1" >/dev/null 2>&1 \
      || { apt-get update -q >/dev/null 2>&1 && DEBIAN_FRONTEND=noninteractive apt-get install -y -q "$1" >/dev/null 2>&1; }
  elif command -v dnf >/dev/null 2>&1; then dnf install -y -q "$2" >/dev/null 2>&1
  elif command -v zypper >/dev/null 2>&1; then zypper -n -q install "$1" >/dev/null 2>&1
  else return 1; fi
}

setup_sandbox() { # bubblewrap, which Synthesis runs contract tests in
  command -v bwrap >/dev/null 2>&1 || install_package bubblewrap bubblewrap || return 1
  # Ubuntu 24.04 and later let a program make user namespaces only under an AppArmor profile that
  # allows it: the distribution's own one for bubblewrap (in apparmor-profiles on 24.04).
  [ "$(sysctl -n kernel.apparmor_restrict_unprivileged_userns 2>/dev/null)" = 1 ] || return 0
  local profile=/etc/apparmor.d/bwrap-userns-restrict extra=/usr/share/apparmor/extra-profiles/bwrap-userns-restrict
  if [ ! -e "$profile" ]; then
    [ -e "$extra" ] || install_package apparmor-profiles apparmor-profiles || return 1
    install -m 644 "$extra" "$profile" || return 1
  fi
  apparmor_parser -r "$profile" >/dev/null 2>&1
}

uninstall() {
  need_root "$@"
  echo "Stopping and removing Local Cognitive Server…"
  systemctl disable --now "$UNIT" >/dev/null 2>&1 || true
  rm -f "/etc/systemd/system/$UNIT.service" "/etc/systemd/system/$UNIT.service.d/nvidia.conf"
  rmdir "/etc/systemd/system/$UNIT.service.d" 2>/dev/null || true
  systemctl daemon-reload || true
  rm -rf "$PREFIX"
  [ "$(readlink /usr/bin/local-cognitive-server 2>/dev/null)" = /usr/local/bin/local-cognitive-server ] && rm -f /usr/bin/local-cognitive-server
  rm -f /usr/local/bin/local-cognitive-server
  echo "Removed. Kept: the data in $DATA_DIR, the credential key in $VAULT_KEY_FILE and the user $SERVICE_USER."
  echo "To delete them too: sudo rm -rf $DATA_DIR $(dirname "$VAULT_KEY_FILE") && sudo userdel $SERVICE_USER"
  echo "The server stays in your computer's Remote list until you choose Forget there."
}

case "$command" in
  help | --help | -h)
    echo "Local Cognitive Server"
    grep '^#   ' "$0" | sed 's/^#   /  /'
    echo
    exec "$NODE" "$CLI" help ;;
  version | --version)
    exec "$NODE" "$CLI" version ;;
  logs)
    shift
    exec journalctl -u "$UNIT" -n 200 -f "$@" ;;
  start | stop | restart)
    need_root "$@"
    systemctl "$command" "$UNIT"
    # `start` in a terminal goes on to the console (not when typed in the console itself).
    if [ "$command" = start ] && [ -t 0 ] && [ -t 1 ] && [ -z "${LOCAL_COGNITIVE_CONSOLE_CHILD:-}" ]; then exec bash "$0" console; fi ;;
  console)
    need_root "$@"
    cd /
    shift
    exec env LOCAL_COGNITIVE_DATA_DIR="$DATA_DIR" "$NODE" "$CLI" console "$@" ;;
  uninstall)
    uninstall "$@" ;;
  cuda)
    need_root "$@"
    case "$(uname -m)" in x86_64 | amd64) variant=linux-x64-cuda12 ;; *) variant="linux-$(uname -m)-cuda12" ;; esac
    release=$(readlink -f "$PREFIX/current")
    command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L 2>/dev/null | grep -q '^GPU ' \
      || { echo "No working NVIDIA driver: install driver 570 or newer (and reboot after updating it)." >&2; exit 1; }
    grep -q "\"$variant\"" "$release/resources/llama/runtime-manifest.json" 2>/dev/null \
      || { echo "This release has no CUDA runtime for $(uname -m) yet: models run on the CPU." >&2; exit 1; }
    if [ -x /usr/bin/nvidia-modprobe ]; then
      mkdir -p "/etc/systemd/system/$UNIT.service.d"
      # GPU 0 and nvidia-uvm as before (a release without gpu-devices still starts), then every GPU.
      printf '[Service]\nExecStartPre=-+/usr/bin/nvidia-modprobe -u -c=0\nExecStartPre=-+/usr/local/bin/local-cognitive-server gpu-devices\n' > "/etc/systemd/system/$UNIT.service.d/nvidia.conf"
      systemctl daemon-reload
    fi
    echo "The CUDA runtime includes NVIDIA CUDA libraries, redistributed under the NVIDIA CUDA Toolkit license:"
    echo "  https://docs.nvidia.com/cuda/eula/"
    # About 2.5 GB is downloaded and unpacked: /var/tmp is on disk, while /tmp is often memory (tmpfs).
    (cd / && TMPDIR=/var/tmp "$NODE" "$release/scripts/prepare-llama-runtime.mjs" --variant "$variant" --destination "$release/resources/llama/$variant")
    chown -R root:root "$release/resources" && chmod -R go-w "$release/resources"
    exec systemctl restart "$UNIT" ;;
  sandbox)
    # Servers installed before 0.1.3 have neither bubblewrap nor a unit that lets it make its
    # namespaces: both come from the running release. The restart lets accepted work finish first.
    need_root "$@"
    setup_sandbox || { echo "bubblewrap could not be set up: install the bubblewrap package, then run this again." >&2; exit 1; }
    unit="/etc/systemd/system/$UNIT.service"
    if ! grep -qs "$PREFIX/current/" "$unit"; then
      echo "$unit was not installed from a release: allow it RestrictNamespaces=user mnt pid ipc net uts cgroup, and see $PREFIX/current/deploy/server/local-cognitive.service." >&2
      exit 1
    fi
    sed -e "s|/srv/local-cognitive|$DATA_DIR|g" "$PREFIX/current/deploy/server/local-cognitive.service" > "$unit.new"
    if cmp -s "$unit.new" "$unit"; then
      rm -f "$unit.new"
    else
      chmod 644 "$unit.new" && mv "$unit.new" "$unit" && systemctl daemon-reload
      echo "The service's settings changed for the sandbox: restarting it…"
      systemctl restart "$UNIT"
    fi
    echo "Synthesis contract tests run in bubblewrap on this server." ;;
  repair-runtimes)
    # Run as root before the service starts (its unit's ExecStartPre): see repair_runtimes.
    need_root "$@"
    repair_runtimes ;;
  gpu-devices)
    # Run as root before the service starts (its unit's nvidia.conf): an NVIDIA device file for every
    # GPU. The service cannot create them itself (NoNewPrivileges stops CUDA's setuid nvidia-modprobe),
    # and CUDA does not see a GPU whose file is missing; the driver creates only what is asked for.
    # It also repairs the CUDA runtime's library links, for units that predate repair-runtimes.
    need_root "$@"
    repair_runtimes || true
    /usr/bin/nvidia-modprobe -u -c=0 || exit 0
    for info in /proc/driver/nvidia/gpus/*/information; do
      [ -r "$info" ] || continue
      minor=$(sed -n 's/^Device Minor:[[:space:]]*//p' "$info")
      if [ -n "$minor" ] && [ "$minor" != 0 ]; then /usr/bin/nvidia-modprobe -c="$minor" || true; fi
    done ;;
  update | rollback | adopt)
    need_root "$@"
    extra=()
    has_option --data-dir "$@" || extra+=(--data-dir "$DATA_DIR")
    has_option --prefix "$@" || extra+=(--prefix "$PREFIX")
    has_option --unit "$@" || extra+=(--unit "$UNIT")
    has_option --user "$@" || extra+=(--user "$SERVICE_USER")
    exec "$NODE" "$CLI" "$@" "${extra[@]}" ;;
  *)
    # Everything else runs as the server's user: its files and control socket are private to it.
    cd /
    settings=(LOCAL_COGNITIVE_DATA_DIR="$DATA_DIR" LOCAL_COGNITIVE_VAULT_KEY_FILE="$VAULT_KEY_FILE")
    if [ "$(id -un)" = "$SERVICE_USER" ]; then exec env "${settings[@]}" "$NODE" "$CLI" "$@"; fi
    need_root "$@"
    exec runuser -u "$SERVICE_USER" -- env "${settings[@]}" "$NODE" "$CLI" "$@" ;;
esac
