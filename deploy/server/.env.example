# Local Cognitive Server options (systemd EnvironmentFile or `start --env-file`), mode 600.
# Directories, host and port come from `--data-dir` and server.json; do not set them here.
# The credential key path is LOCAL_COGNITIVE_VAULT_KEY_FILE (see local-cognitive.service).

DEFAULT_PROVIDER=llamacpp
LLAMA_CONTEXT_SIZE=8192
LLAMA_GPU_LAYERS=auto
# The llama.cpp build is chosen by `start --inference auto|cuda|cpu`: auto uses
# resources/llama/linux-x64-cuda12 (npm run prepare:llama:server) when it matches this release.
# Set LLAMA_RUNTIME_DIR (via --llama-runtime-dir) only for a custom build.
FILESYSTEM_ACCESS_MODE=restricted

# Optional cloud providers (chats, agents and Synthesis on this server). A provider below appears
# when its key is set; restart the server after a change (sudo local-cognitive-server restart).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
QWEN_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
PERPLEXITY_API_KEY=
# Any other OpenAI-compatible service: LOCAL_COGNITIVE_PROVIDER_<ID>_BASE_URL with its key and model
# (and optionally _NAME, _DIALECT, _TIMEOUT_MS). Its id is <ID> in lower case, with - for _.
# A service that takes no key still needs one here: any value.
# LOCAL_COGNITIVE_PROVIDER_LAB_BASE_URL=https://llm.example.com/v1
# LOCAL_COGNITIVE_PROVIDER_LAB_API_KEY=
# LOCAL_COGNITIVE_PROVIDER_LAB_MODEL=
# LOCAL_COGNITIVE_PROVIDER_LAB_NAME=Lab GPU

# Integrations.
BRAVE_SEARCH_API_KEY=
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_USER_IDS=

# Key rotation: previous keys, separated by ":"; reads accept them, writes use the current key.
# LOCAL_COGNITIVE_VAULT_PREVIOUS_KEY_FILES=/etc/local-cognitive/vault.previous.key
