# Local Cognitive Server (headless). Installed by deploy/server/install.sh:
#   curl -fsSL https://github.com/Ilyaberdar/local-cognitive-AI-system/releases/latest/download/install.sh | sudo bash
# A release is unpacked to /opt/local-cognitive/releases/<version> (with its own Node in node/), and
# /opt/local-cognitive/current points to the running one. Day to day:
#   sudo local-cognitive-server pair | status | devices | logs | update | uninstall
[Unit]
Description=Local Cognitive Server
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/local-cognitive

[Service]
Type=exec
User=local-cognitive
Group=local-cognitive
# Provider keys and options (KEY=value), mode 600. Optional.
EnvironmentFile=-/etc/local-cognitive/server.env
Environment=NODE_ENV=production
Environment=LOCAL_COGNITIVE_VAULT_KEY_FILE=/etc/local-cognitive/vault.key
ExecStart=/opt/local-cognitive/current/node/bin/node /opt/local-cognitive/current/dist/src/server/cli.js start --data-dir /srv/local-cognitive --inference auto
# SIGTERM drains accepted work. mixed: only the main process gets it, so model processes keep
# running until the server stops them.
KillMode=mixed
TimeoutStopSec=180
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=64 75 78
UMask=0077
LimitCORE=0

# Hardening. Not used: PrivateDevices/DevicePolicy (GPU access), MemoryDenyWriteExecute
# (V8 and CUDA JIT), SystemCallFilter. NoNewPrivileges blocks setuid nvidia-modprobe, so load
# nvidia-uvm at boot on GPU hosts.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/local-cognitive
ProtectHome=read-only
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
