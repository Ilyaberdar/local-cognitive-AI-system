# Production values for deploy/cloud/compose.yml. Copy to .env next to it and chmod 600.
CLOUD_DOMAIN=api.example.com
POSTGRES_PASSWORD=
AUTH0_ISSUER=https://your-tenant.eu.auth0.com/
AUTH0_AUDIENCE=https://api.example.com
# Web pages allowed to call the API from a browser (the account page), comma-separated; empty allows none.
CORS_ORIGINS=https://local-cognitive.com
LOG_LEVEL=info
