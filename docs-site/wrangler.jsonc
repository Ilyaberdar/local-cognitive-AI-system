// Cloudflare Workers: the built site as static assets (docs.local-cognitive.com). worker.js runs
// first only for /videos/*, to answer the byte ranges a video player needs for seeking.
{
  "name": "local-cognitive-docs",
  "compatibility_date": "2026-10-01",
  "main": "./worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/videos/*"]
  }
}
